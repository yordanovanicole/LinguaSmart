@model IEnumerable<LinguaSmart.DTOs.WordDto>

@{
    ViewData["Title"] = "Речник";
}

<h2>Моят езиков речник</h2>

<p>Списък с английски думи и техните преводи.</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Търси дума или превод..." />

        <button type="submit" class="btn btn-primary">
            Търси
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Изчисти
        </a>
    </div>
</form>


<a asp-action="Create" class="btn btn-primary mb-3">
    Добави нова дума
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Английска дума</th>
            <th>Превод на български</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var word in Model)
        {
            <tr>
                <td>@word.EnglishWord</td>
                <td>@word.BulgarianTranslation</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@word.Id"
                       class="btn btn-info btn-sm">
                        Подробности
                    </a>


                    <a asp-action="Edit"
                       asp-route-id="@word.Id"
                       class="btn btn-warning btn-sm">
                        Редактирай
                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@word.Id"
                       class="btn btn-danger btn-sm">
                        Изтрий
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>
